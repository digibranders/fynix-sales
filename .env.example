# Copy to .env for local development.
PORT=3000
# SQLite file. Use :memory: for a throwaway database.
DATABASE_URL=postgres://localhost:5432/fynix_sales
# Set to production when deployed behind HTTPS so cookies are marked Secure.
NODE_ENV=development
SESSION_DAYS=14
# Password given to every seeded demo account (development only).
# The seed refuses to run with NODE_ENV=production unless this is set to a strong value.
SEED_PASSWORD=fynix-dev-2026

# Email (optional). Without a key the superadmin copies each invite link from the screen and sends it themselves.
# Brevo: Profile menu > SMTP & API > API Keys. The sender address must be verified in Brevo (Senders, Domains & Dedicated IPs).
# Put keys in your own .env file or the server's settings, never in the repository.
APP_URL=http://127.0.0.1:3000
BREVO_API_KEY=
MAIL_FROM=Fynix Sales <no-reply@your-verified-domain.com>
# Resend still works if BREVO_API_KEY is empty:
RESEND_API_KEY=
