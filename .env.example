# Copy to .env for local development.
PORT=3000
# SQLite file. Use :memory: for a throwaway database.
DATABASE_URL=postgres://localhost:5432/fynix_sales
# Set to production when deployed behind HTTPS so cookies are marked Secure.
NODE_ENV=development
SESSION_DAYS=14
# Password given to every seeded demo account (development only).
# The seed refuses to run with NODE_ENV=production unless this is set to a strong value.
SEED_PASSWORD=fynix-dev-2026

# Email through Resend (optional). Without these, the temporary password is shown on screen instead.
# Create the key in your Resend dashboard and put it in your own .env file, never in the repository.
APP_URL=http://127.0.0.1:3000
RESEND_API_KEY=
MAIL_FROM=Fynix Sales <no-reply@your-verified-domain.com>
