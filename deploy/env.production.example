# Copy to /etc/fynix-sales.env on the server (chmod 600, owned by root). Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3600
APP_URL=https://sales.fynix.digital
DATABASE_URL=postgres://fynixsales:CHANGE_ME@127.0.0.1:5432/fynix_sales
SESSION_DAYS=14
# Emails stay off until these are set:
RESEND_API_KEY=
MAIL_FROM=
