# Lives on the server as /srv/fynix-sales/shared/.env (owner fsdeploy, group fynixsales, mode 640). Never commit the real file.
HOST=127.0.0.1
PORT=3600
APP_URL=https://sales.fynix.digital
DATABASE_URL=postgres://fynix_sales:CHANGE_ME@127.0.0.1:5432/fynix_sales
SESSION_DAYS=14
# Emails stay off until both are set:
# Email for invite links. Leave empty to copy links by hand. Quote MAIL_FROM because it has spaces.
BREVO_API_KEY=
MAIL_FROM="Fynix Sales <no-reply@fynix.digital>"
# Resend works too if BREVO_API_KEY is empty:
RESEND_API_KEY=
